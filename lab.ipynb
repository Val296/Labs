import requests
import pandas as pd

def load_vhi_data(province_id):
    url = "https://www.star.nesdis.noaa.gov/smcd/emb/vci/VH/get_TS_admin.php"
    
    params = {
        "country": "UKR",
        "provinceID": province_id,
        "year1": "1981",
        "year2": "2024",
        "type": "Mean"
    }
    
    response = requests.get(url, params=params)
    
    filename = f"vhi_{province_id}.csv"
    
    with open(filename, "w") as f:
        f.write(response.text)
    
    return filename

def clean_data(file):
    df = pd.read_csv(file, header=1)
    
    df = df.dropna(axis=1, how='all')
    df = df.dropna()
    
    df.columns = ["Year", "Week", "SMN", "SMT", "VCI", "TCI", "VHI"]
    
    return df

def add_region(df, region_name):
    df["Region"] = region_name
    return df

def get_vhi_for_year(df, year):
    return df[df["Year"] == year][["Week", "VHI"]]

def get_vhi_range(df, start, end):
    return df[(df["Year"] >= start) & (df["Year"] <= end)]

def get_stats(df):
    return {
        "min": df["VHI"].min(),
        "max": df["VHI"].max(),
        "mean": df["VHI"].mean(),
        "median": df["VHI"].median()
    }
file = load_vhi_data(1)

df = clean_data(file)

df = add_region(df, "Cherkasy")

print(get_vhi_for_year(df, 2020).head())

print(get_stats(df))
